---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { withBase } from '../lib/config';

const options = [
  {
    code: 'EN',
    name: 'English',
    href: withBase('/en'),
    intro: 'Menu, contacts and cart in English.',
  },
  {
    code: 'RU',
    name: 'Русский',
    href: withBase('/ru'),
    intro: 'Меню, контакты и корзина на русском языке.',
  },
  {
    code: 'EL',
    name: 'Ελληνικά',
    href: withBase('/el'),
    intro: 'Μενού, επικοινωνία και καλάθι στα ελληνικά.',
  },
  {
    code: 'UK',
    name: 'Українська',
    href: withBase('/uk'),
    intro: 'Меню, контакти і кошик українською мовою.',
  },
  {
    code: 'PL',
    name: 'Polski',
    href: withBase('/pl'),
    intro: 'Menu, kontakt i koszyk po polsku.',
  },
];
---

<Layout
  lang="en"
  title="Select Language - Tastyfood"
  alternatePath={false}
>
  <Navigation lang="en" currentPage="menu" />

  <main class="language-page">
    <section class="language-card" aria-labelledby="language-title">
      <h1 id="language-title" class="language-card__title">Choose your language</h1>
      <p class="language-card__intro">
        Select the language for the menu, contacts and cart.
      </p>

      <nav class="language-list" aria-label="Languages">
        {options.map(option => (
          <a
            class="language-option"
            href={option.href}
            data-language-link
            data-language-code={option.code.toLowerCase()}
          >
            <span class="language-option__content">
              <strong class="language-option__name">{option.name}</strong>
              <small class="language-option__intro">{option.intro}</small>
            </span>
            <em class="language-option__code">{option.code}</em>
          </a>
        ))}
      </nav>
    </section>
  </main>

  <script>
    // Clear cart when selecting a new language
    document.querySelectorAll('[data-language-link]').forEach(link => {
      link.addEventListener('click', () => {
        window.tastyfoodAnalytics.track('language_change', {
          page_type: 'language',
          from_language: document.documentElement.lang || 'en',
          to_language: link.getAttribute('data-language-code') || 'unknown',
        });

        if (window.tastyfoodCart) {
          window.tastyfoodCart.write([]);
        }
      });
    });
  </script>
</Layout>
