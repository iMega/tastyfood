---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import ContactPage from '../../components/ContactPage.astro';
import { t, defaultLanguage } from '../../lib/i18n';

const lang = defaultLanguage;
const title = t(lang, 'contact.title');
---

<Layout
  lang={lang}
  title={`${title} - Tastyfood`}
  alternatePath="/contact"
>
  <Navigation lang={lang} currentPage="contact" />
  <ContactPage lang={lang} title={title} />
</Layout>
