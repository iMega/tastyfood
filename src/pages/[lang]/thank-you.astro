---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { t, type Language } from '../../lib/i18n';
import { withBase } from '../../lib/config';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'el' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'pl' } },
  ];
}

const { lang } = Astro.params as { lang: Language };
const title = `${t(lang, 'thank_you.title')} - Tastyfood`;
---

<Layout lang={lang} title={title} alternatePath="/thank-you">
  <Navigation lang={lang} currentPage="cart" />

  <main class="language-page">
    <section class="language-card" aria-labelledby="thank-you-title">
      <h1 id="thank-you-title" class="language-card__title">{t(lang, 'thank_you.title')}</h1>
      <p class="language-card__intro">
        {t(lang, 'thank_you.message')}
      </p>

      <a class="thank-you-action" href={withBase(`/${lang}/`)}>
        {t(lang, 'thank_you.back_to_menu')}
      </a>
    </section>
  </main>

  <script>
    window.tastyfoodAnalytics.purchase();
  </script>
</Layout>
