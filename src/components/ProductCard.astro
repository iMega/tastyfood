---
import { Picture } from 'astro:assets';
import { t, type Language } from '../lib/i18n';
import type { MenuItem, ProductPrice } from '../lib/menu';

interface Props {
  id: string;
  name: string;
  orderName: string;
  shortName: string;
  cardDescription: string;
  locale: Language;
  price: ProductPrice;
  weight: number;
  portions: number;
  image: MenuItem['image'];
  imageUrl: string;
  href: string;
  categoryId: string;
  categories?: string[];
  badge?: 'hit' | 'new';
  allergens: string[];
  imageLoading?: 'eager' | 'lazy';
  imageFetchPriority?: 'high' | 'low' | 'auto';
}

const {
  id,
  name,
  orderName,
  shortName,
  cardDescription,
  locale,
  price,
  weight,
  portions,
  image,
  imageUrl,
  href,
  categoryId,
  categories = [],
  badge,
  allergens,
  imageLoading = 'lazy',
  imageFetchPriority,
} = Astro.props;

const formatPrice = (price: ProductPrice, locale: Language): string => {
  return new Intl.NumberFormat(locale, {
    style: 'currency',
    currency: price.currency,
    currencyDisplay: 'narrowSymbol',
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  }).format(price.value);
};

const formatWeight = (grams: number): string => {
  if (grams >= 1000) {
    const kg = grams / 1000;

    return new Intl.NumberFormat(locale, {
      style: 'unit',
      unit: 'kilogram',
      unitDisplay: 'short',
      maximumFractionDigits: 1,
    }).format(kg);
  }

  return new Intl.NumberFormat(locale, {
    style: 'unit',
    unit: 'gram',
    unitDisplay: 'short',
    maximumFractionDigits: 0,
  }).format(grams);
};

const formatNumber = (value: number): string => {
  return new Intl.NumberFormat(locale, {
    maximumFractionDigits: 0,
  }).format(value);
};

const primaryAllergen = allergens[0];
const formattedPrice = formatPrice(price, locale);
const formattedWeight = formatWeight(weight);
const addToCartLabel = t(locale, 'product.add_to_cart');
const meta = [
  `${formatNumber(portions)} ${t(locale, 'product.portions')}`,
  primaryAllergen,
].filter(Boolean);
---

<article
  class="product-card"
  data-categories={categories.join(' ')}
>
  {badge && (
    <span class={`badge badge-${badge}`}>
      {t(locale, `product.badge.${badge}`)}
    </span>
  )}

  <a href={href} class="product-image-link" aria-label={name}>
    <Picture
      src={image}
      alt={name}
      class="product-image"
      formats={['webp']}
      fallbackFormat="png"
      widths={[320, 480, 640, 960]}
      sizes="(max-width: 520px) 100vw, (max-width: 1024px) 50vw, 33vw"
      loading={imageLoading}
      fetchpriority={imageFetchPriority}
      decoding="async"
    />
  </a>

  <div class="product-info">
    <div class="product-text">
      <h2 class="product-name">
        <a href={href} aria-label={name}>{shortName}</a>
      </h2>
      <p class="product-description">{cardDescription}</p>

      <div class="product-meta">
        {meta.join(' · ')}
      </div>
    </div>

    <div class="product-footer">
      <span class="product-price">
        <span class="product-price__value">{formattedPrice}</span>
        <span class="product-price__note">
          {formattedWeight} · {t(locale, 'product.whole_pie')}
        </span>
      </span>
      <button
        class="add-to-cart"
        title={addToCartLabel}
        aria-label={addToCartLabel}
        data-cart-button
        data-product-id={id}
        data-product-name={name}
        data-product-order-name={orderName}
        data-product-category={categoryId}
        data-product-variant={`${weight} g`}
        data-product-price={price.value}
        data-product-currency={price.currency}
        data-product-image={imageUrl}
      >
        <span class="add-icon" data-cart-button-label>+</span>
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    color: var(--text);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 8px var(--shadow-soft);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .product-card.is-hidden {
    display: none;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px var(--shadow);
  }

  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    min-height: 24px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    z-index: 2;
    color: oklch(100% 0 0deg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .badge-hit {
    background: linear-gradient(135deg, oklch(70.45% 0.1926 39.23deg) 0%, oklch(67.92% 0.2128 36.53deg) 100%);
  }

  .badge-new {
    background: linear-gradient(135deg, oklch(67.31% 0.1624 144.21deg) 0%, oklch(63.01% 0.1516 144.28deg) 100%);
  }

  .product-image {
    width: 100%;
    height: 172px;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
  }

  .product-image-link {
    display: block;
    aspect-ratio: 16 / 9;
    color: inherit;
    text-decoration: none;
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-muted) 100%);
    overflow: hidden;
  }

  .product-image-link::after {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, oklch(42.44% 0.0717 59.27deg / 0%), oklch(42.44% 0.0717 59.27deg / 12%), oklch(42.44% 0.0717 59.27deg / 0%));
  }

  .product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    color: var(--text);
    padding: 14px 14px 0;
  }

  .product-text {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .product-name {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-cool);
    min-height: 2.75rem;
    line-height: 1.22;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-name a {
    color: inherit;
    text-decoration: none;
  }

  .product-name a:hover {
    text-decoration: underline;
  }

  .product-description {
    font-size: 0.875rem;
    color: var(--text-soft);
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: auto;
    min-height: 50px;
    padding: 10px 56px 8px 0;
  }

  .product-price {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--text-cool);
  }

  .product-price__value {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.05;
  }

  .product-price__note {
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .add-to-cart {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 42px;
    height: 42px;
    border-radius: 16px 0 0;
    background: var(--accent);
    border: none;
    color: var(--accent-text);
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .add-to-cart:hover {
    background: var(--accent-hover);
  }

  .add-to-cart.is-in-cart {
    background: var(--success);
    font-size: 1rem;
    font-weight: 800;
  }

  .add-to-cart.is-in-cart:hover {
    background: var(--success-hover);
  }

  .add-icon {
    font-weight: 200;
    line-height: 1;
  }

  .add-to-cart.is-in-cart .add-icon {
    font-weight: 800;
  }

  @media (32.5625rem <= width <= 64rem) {
    .product-image {
      object-position: center;
      transform: scale(1.04);
    }

    .product-info {
      padding: 14px 14px 0;
    }
  }

  @media (width <= 32.5rem) {
    .product-image-link {
      aspect-ratio: 16 / 8.4;
    }

    .product-image {
      height: 100%;
      object-position: center;
      transform: none;
    }

    .product-info {
      padding: 12px 12px 0;
    }

    .product-text {
      gap: 6px;
    }

    .product-name {
      min-height: auto;
      font-size: 1.1875rem;
      line-height: 1.2;
    }

    .product-description {
      font-size: 0.875rem;
      line-height: 1.34;
    }

    .product-meta {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.25;
    }

    .product-footer {
      min-height: 56px;
      padding: 10px 62px 8px 0;
    }

    .product-price__value {
      font-size: 1.375rem;
    }

    .product-price__note {
      padding-bottom: 2px;
      color: var(--text-muted);
    }

    .add-to-cart {
      width: 54px;
      height: 54px;
      font-size: 1.375rem;
      border-radius: 18px 0 0;
    }
  }
</style>
