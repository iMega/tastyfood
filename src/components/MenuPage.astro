---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import ProductCard from './ProductCard.astro';
import { t, type Language } from '../lib/i18n';
import {
  getMenuItems,
  getCategories,
  getLocalizedMenuItem,
  getLocalizedCategory,
} from '../lib/menu';
import { withBase } from '../lib/config';
import { menuOpenGraph } from '../lib/seo';
import { productPath } from '../lib/productPaths';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const menuItems = await getMenuItems();
const categories = [...getCategories()].sort((a, b) => a.order - b.order);
const promo = import.meta.env.PUBLIC_SITE_PROMO ?? 'none';
const promoKeys = new Set([
  'holiday-menu',
  'easter-table',
  'green-monday',
  'summer-menu',
  'harvest-menu',
]);
const promoKey = promoKeys.has(promo) ? promo : null;
---

<Layout
  lang={lang}
  title={t(lang, 'menu.title')}
  openGraph={menuOpenGraph(lang)}
  alternatePath="/"
>
  <Navigation lang={lang} currentPage="menu" />

  <main class="main">
    <div class="container">
      <section class="menu-intro" aria-label={t(lang, 'menu.aria')}>
        <h1 class="menu-intro__title">{t(lang, 'menu.heading')}</h1>
        <p class="menu-intro__text">{t(lang, 'menu.intro')}</p>
      </section>

      {promoKey && (
        <section class="season-banner" aria-label={t(lang, 'seasonal.aria')}>
          <h2 class="season-banner__title">
            {t(lang, `seasonal.promos.${promoKey}.title`)}
          </h2>
          <p class="season-banner__text">
            {t(lang, `seasonal.promos.${promoKey}.text`)}
          </p>
        </section>
      )}

      <div class="category-filters">
        {categories.map(category => {
          const localizedCategory = getLocalizedCategory(category, lang);

          return (
            <button
              type="button"
              class={`filter-btn ${category.id === 'all' ? 'active' : ''}`}
              data-category={category.id}
            >
              {localizedCategory.name}
            </button>
          );
        })}
      </div>

      <div class="products-grid">
        {menuItems.map((item, index) => {
          const product = getLocalizedMenuItem(item, lang);

          return (
            <ProductCard
              id={item.id}
              name={product.name}
              shortName={product.shortName}
              cardDescription={product.cardDescription}
              locale={lang}
              allergens={product.details.allergens}
              price={item.price}
              weight={item.weight}
              portions={item.portions}
              image={item.image}
              imageUrl={item.imageUrl}
              href={withBase(productPath(item, lang))}
              categoryId={item.categoryId}
              categories={item.categories}
              badge={item.badge}
              imageLoading={index < 3 ? 'eager' : 'lazy'}
              imageFetchPriority={index === 0 ? 'high' : undefined}
            />
          );
        })}
      </div>
    </div>
  </main>

  <script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const products = document.querySelectorAll('.product-card');
    const cartButtons = document.querySelectorAll('[data-cart-button]');
    const productLinks = document.querySelectorAll(
      '.product-image-link, .product-name a'
    );

    const visibleProducts = () => {
      return Array.from(products).filter(product => {
        return product instanceof HTMLElement
          && !product.classList.contains('is-hidden');
      });
    };

    const trackVisibleList = () => {
      const items = visibleProducts()
        .map(product => {
          const button = product.querySelector('[data-cart-button]');

          return button
            ? window.tastyfoodAnalytics.productFrom(button)
            : null;
        })
        .filter(Boolean)
        .map((product, index) => ({
          item_id: product.id,
          item_name: product.name,
          item_category: product.category,
          item_variant: product.variant,
          price: product.price,
          quantity: 1,
          index,
        }));

      window.tastyfoodAnalytics.track('view_item_list', {
        page_type: 'menu',
        item_list_id: 'menu',
        item_list_name: 'Menu',
        items,
      });
    };

    const updateProductCartButtons = () => {
      const cart = window.tastyfoodCart.read();

      cartButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }

        const productId = button.getAttribute('data-product-id');
        const item = cart.find(entry => entry.id === productId);
        const quantity = Number(item?.quantity || 0);
        const label = button.querySelector('[data-cart-button-label]');

        button.classList.toggle('is-in-cart', quantity > 0);
        button.setAttribute('aria-pressed', quantity > 0 ? 'true' : 'false');

        if (label) {
          label.textContent = quantity > 0 ? String(quantity) : '+';
        }
      });
    };

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        filterBtns.forEach(button => button.classList.remove('active'));
        btn.classList.add('active');

        products.forEach(product => {
          const categories = product.getAttribute('data-categories') || '';
          const isVisible = category === 'all'
            || categories.split(' ').includes(category || '');

          product.classList.toggle('is-hidden', !isVisible);
        });

        window.tastyfoodAnalytics.track('filter_select', {
          page_type: 'menu',
          filter_name: category,
        });
        trackVisibleList();
      });
    });

    productLinks.forEach(link => {
      link.addEventListener('click', () => {
        const card = link.closest('.product-card');
        const button = card?.querySelector('[data-cart-button]');

        if (!button) {
          return;
        }

        const product = window.tastyfoodAnalytics.productFrom(button);

        window.tastyfoodAnalytics.track('select_item', {
          page_type: 'menu',
          item_list_id: 'menu',
          item_list_name: 'Menu',
          source_section: 'catalog',
          items: [{
            item_id: product.id,
            item_name: product.name,
            item_category: product.category,
            item_variant: product.variant,
            price: product.price,
            quantity: 1,
          }],
        });
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest('.add-to-cart') as HTMLButtonElement | null;

      if (!button) {
        return;
      }

      window.tastyfoodCart.add(
        window.tastyfoodAnalytics.productFrom(button),
        'catalog'
      );
    });

    trackVisibleList();
    updateProductCartButtons();
    window.addEventListener('tastyfood-cart-change', updateProductCartButtons);
  </script>
</Layout>
