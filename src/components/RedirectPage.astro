---
import { absoluteUrl, withBase } from '../lib/config';

interface Props {
  to: string;
}

const { to } = Astro.props;
const site = Astro.site;

if (!site) {
  throw new Error('Set site in astro.config.mjs to build redirect pages.');
}

const redirectTo = withBase(to);
const canonical = absoluteUrl(to);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content={`0; url=${redirectTo}`}>
    <link rel="canonical" href={canonical}>
    <title>Redirecting...</title>
  </head>
  <body>
    <script is:inline define:vars={{ redirectTo }}>
      window.location.replace(redirectTo);
    </script>
    <a href={redirectTo}>Continue</a>
  </body>
</html>
