---
import { absoluteUrl, withBase } from '../lib/config';

interface Props {
  to: string;
}

const { to } = Astro.props;
const site = Astro.site;

if (!site) {
  throw new Error('Set site in astro.config.mjs to build redirect pages.');
}

const redirectTo = withBase(to);
const canonical = absoluteUrl(to);
const description = 'Redirecting to Tastyfood.';
const image = absoluteUrl('/og/homepage.jpg');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content={`0; url=${redirectTo}`}>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="index,follow">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Tastyfood">
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content={canonical}>
    <meta name="twitter:card" content="summary_large_image">
    <title>Redirecting...</title>
  </head>
  <body>
    <script is:inline define:vars={{ redirectTo }}>
      window.location.replace(redirectTo);
    </script>
    <a href={redirectTo}>Continue</a>
  </body>
</html>
