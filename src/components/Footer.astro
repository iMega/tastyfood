---
import { contact as common } from '../lib/contact';
import type { Language } from '../lib/i18n';
import { withBase } from '../lib/config';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-wrapper">
    <a class="footer-address" href={withBase(`/${lang}/contact`)}>{common.address}</a>
    <a class="footer-phone" href={common.phoneHref}>{common.phone}</a>
  </div>
</footer>
